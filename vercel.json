{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/internal/purge-expired-stores",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "fonts/**"
    }
  }
}
