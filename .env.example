# Copy to .env at the repository root. Never commit the real file.
# PostgreSQL (Neon free tier works great): postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/digital_dukaan
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# ImageKit private API key (free tier) - required for production image uploads
IMAGEKIT_PRIVATE_KEY=
# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Only used by the seed command.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_STORE_WHATSAPP=919999999999

# Project-scoped Vercel token for future shop domains (expires 2027-09-29)
VERCEL_STORE_DOMAIN_TOKEN=
STORE_SUBDOMAINS_READY=false
VITE_STORE_SUBDOMAINS_READY=false

# CRM phase: opt in only after migration/testing; default off.
CRM_ENABLED=false
# WhatsApp Cloud API sandbox. Never place the temporary access token in git or client env.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_TEST_SEND_ENABLED=false
WHATSAPP_TEST_PHONE_NUMBER_ID=1261397693731087
WHATSAPP_TEST_WABA_ID=219715891199851
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENT=
